# Подключение к БД
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД?schema=public
# Пример: postgresql://postgres:12345@localhost:5432/braslav_gis?schema=public
# PostgreSQL 16+

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/braslav_gis?schema=public"

# URL фронтенда (для CORS)
# Локально: http://localhost:5173
# Продакшен: https://your-app.netlify.app

FRONTEND_URL=https://your-app.netlify.app

# JWT СЕКРЕТ
# Сгенерируйте случайную строку в 32 символа
# Можно через: openssl rand -base64 64

JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Порт сервера

PORT=3000

# Режим (прод)

NODE_ENV=production
